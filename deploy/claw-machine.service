[Unit]
Description=Claw Machine Backend (FastAPI)
After=network.target

[Service]
User=pi
Group=pi
WorkingDirectory=/home/pi/claw-machine/backend
Environment="PATH=/home/pi/claw-machine/backend/venv/bin"
ExecStart=/home/pi/claw-machine/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
